CREATE DATABASE BOOKSTORE;
CREATE TABLE AUTHOR(AUTHOR_ID VARCHAR(100), FIRSTNAME VARCHAR(100), LASTNAME VARCHAR(100), BIOGRAPHY TEXT, DOB DATE);
CREATE TABLE PUBLISHER(ID VARCHAR(100), NAME VARCHAR(100), COUNTRY VARCHAR(100));
CREATE TABLE BOOK(BOOKID VARCHAR(100), TITLE VARCHAR(100), ISBN VARCHAR(100), PUBLISHED_DATE DATE, PRICE INT(10));

CREATE DATABASE CLINIC;
CREATE TABLE PATIENT(PHONE_NO INT(11), FIRSTNAME VARCHAR(100), LASTNAME VARCHAR(100), DOB DATE);
CREATE TABLE DOCTOR(DOCTOR_ID INT (10), FIRSTNAME VARCHAR(100), LASTNAME VARCHAR(100), SPECIALTY TEXT, LICENSED_DATE DATE);
CREATE TABLE APPOINTMENTS(ID INT (100), DOA DATE, REASON TEXT, STATUS ENUM('SCHEDULED', 'COMPLETED','CANCELED', 'NO-HOW'));

CREATE DATABASE COURSE_CATALOG;
CREATE TABLE DEPARTMENT(ID INT(100), NAME VARCHAR(100), OFFICE_LOCATION TEXT);
CREATE TABLE COURSES(ID INT(10), CODE VARCHAR(6), TITLE VARCHAR(100), CREDITS INT(3));
