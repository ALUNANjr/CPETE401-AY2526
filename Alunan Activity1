CREATE DATABASE BOOKSTORE;
create table Author(
    ID int(10) unsigned not null, Firstname Varchar(50) not null, Lastname Varchar(50) not null, Biography text, Birthdate date);
create table Publisher(
    ID int (10) unsigned not null, Name Varchar(50) not null, Country Varchar(50) not null);
create table Books(
    ID int (10) unsigned NOT NULL, Title Varchar (50) NOT Null, ISBN int (10) unsigned Not Null, Published date, Price int (10) unsigned Not Null);

CREATE DATABASE CLINIC;
create table Patient(
     ID int(10) unsigned not null, Firstname Varchar(50) not null, Lastname Varchar (50) not null, Birthdate date,
     Phone_no int (11) unsigned not null, Record_date date);
create table Doctors(
     ID int(11) unsigned not null, Firstname Varchar(50) not null, Lastname Varchar (50) not null,
     Specialty Varchar(50) not null, Year_license int (4) unsigned not null);
create table Appointments(
     ID int(10) unsigned not null, Appointment_date datetime, Reason Varchar (15) not null, Status enum('Scheduled',
     'Completed', 'Canceled', 'No-Show'));

CREATE DATABASE COURSE_CATALOG;
 create table Departments(
     ID int(10) unsigned not null, Name Varchar(50) not null, Location Varchar(50) not null);
create table Courses(
     ID int (10) unsigned not null, Code Varchar(10) not null, Title Varchar(50) not null, Credits int(2) unsigned
     not null);
